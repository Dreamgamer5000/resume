      "items": [
        {
          "id": "02487ca4-a988-4537-a509-7564b857f0b7",
          "visible": true,
          "name": "Reinforcement Learning — BipedalWalker (TD3 & TD3-FORK)",
          "description": "Personal Project",
          "date": "",
          "summary": "<ul><li>Implemented TD3 from scratch in PyTorch (replay buffer, twin critics, actor, Polyak target updates) with no RL library dependencies; trained on BipedalWalker-v3 to avg reward +280/300 in 1M steps on personal GPU.</li><li>Built a live 6-panel Matplotlib training dashboard (reward curves, Q-value drift, action distributions, TD error) and a threaded pygame render window with HUD overlay displaying training in real time without blocking the training loop.</li><li>Extended the agent with TD3-FORK (forward dynamics model predicting next state from current state-action) to address long-horizon credit assignment failure on BipedalWalkerHardcore-v3; reward improved from a plateau of −40 to +100+ within 900k steps.</li></ul>",
          "keywords": ["PyTorch", "Gymnasium", "CUDA", "Python"],
          "url": { "label": "", "href": "" }
        },
        {
          "id": "cbed9b6a-753b-44a3-92ba-49a06149c778",
          "visible": true,
          "name": "Image Denoising Autoencoder",
          "description": "Deep Learning Project",
          "date": "",
          "summary": "<ul><li>Built a hybrid Inception-ResNet denoising autoencoder in TensorFlow/Keras trained on DIV2K, using Inception blocks (1×1, 3×3, 5×5 branches) and stacked ResNet residual blocks across a 3-stage encoder.</li><li>Implemented a U-Net style decoder with skip connections and mixed-precision training (float16 activations) to preserve spatial detail while halving activation VRAM consumption.</li><li>Engineered a memory-efficient pipeline using a custom Keras Sequence generator for on-the-fly noise augmentation across 5000 training patches extracted from 800 source images.</li></ul>",
          "keywords": ["TensorFlow", "Keras", "Python"],
          "url": { "label": "GitHub", "href": "https://github.com/kaezrr/image-denoiser-scaler" }
        },
        {
          "id": "a9e5009f-6869-4039-9dd5-5829601b146d",
          "visible": true,
          "name": "HackHub Game — OctoRhythm",
          "description": "Game Development",
          "date": "HackHub 2025",
          "summary": "<ul><li>Developed OctoRhythm, a rhythm-based game for HackHub 2025 using the Godot engine and GDScript.</li><li>Designed timing-based scoring and dynamic difficulty adjustment to enhance player engagement.</li><li>Created and integrated sprites and animations, ensuring a cohesive visual style.</li><li>Collaborated with a team to optimize performance and troubleshoot issues for a stable release.</li></ul>",
          "keywords": ["Godot", "GDScript"],
          "url": { "label": "GitHub", "href": "https://github.com/bawling-hackhub/hackhub-game" }
        }
      ]
